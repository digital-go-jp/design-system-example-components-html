{
  "name": "design-system-example-components-html",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build && npm run manifest:generate -- --publish storybook-static",
    "manifest:generate": "node scripts/generate-component-manifest.mjs",
    "test:manifest": "node --test scripts/manifest/*.test.mjs",
    "test": "npm run test:manifest && vitest --run && playwright test",
    "test:setup": "playwright install chromium",
    "test:storybook": "vitest --project=storybook --run",
    "test:unit": "vitest --project=unit --run",
    "test:browser": "vitest --project=browser --run",
    "test:vrt": "playwright test",
    "format": "npx @biomejs/biome format --write ."
  },
  "dependencies": {
    "@digital-go-jp/design-tokens": "^2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/html-vite": "10.6.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "bootstrap": "^5.3.8",
    "invokers-polyfill": "^1.0.4",
    "jsdom": "^30.1.3",
    "kiso.css": "^1.2.4",
    "node-html-parser": "^9.0.5",
    "normalize.css": "^8.0.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "reset-css": "^5.0.2",
    "storybook": "10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.12.1",
      "onFail": "error"
    }
  },
  "overrides": {
    "storybook": "$storybook"
  }
}
